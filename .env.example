# Copy this file to .env and add your Gemini API key.
GOOGLE_API_KEY=
GEMINI_LLM_MODEL=gemini-3-flash-preview
GEMINI_EMB_MODEL=models/gemini-embedding-001

# Host-based development; Docker Compose overrides container addresses.
AGENT_BASE_URL=http://127.0.0.1:8080
TRANSLATOR_BASE_URL=http://127.0.0.1:8000
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION=paper_chunks
MILVUS_DIMENSION=3072
MILVUS_USERNAME=
MILVUS_PASSWORD=
TOP_K=4
CHUNK_SIZE=900
CHUNK_OVERLAP=150
